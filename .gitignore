# Mac OS
.DS_Store

# NPM
/node_modules
npm-*

# Testing
/.nyc_output
/coverage

# Build
/build
/dist
/.opt-in

# Generated translation files
/translations
/locale

# Other generated source
/src/generated

# Downloaded during "npm install": the upstream scratch-microbit hex (and the
# DAL blocks-dal.hex). But the Calliope v3 blocks runtime + its version metadata
# are committed deliverables (see firmware/BUILD-PROVENANCE.md) — shipped WITH
# the editor, not rebuilt at deploy — so track those two explicitly.
/static/microbit/*
!/static/microbit/blocks.hex
!/static/microbit/blocks-version.json

# HTTPS certification
*.pem

# PWA
assetsManifest.json
