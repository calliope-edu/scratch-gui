# Mac OS
.DS_Store

# NPM
/node_modules
npm-*

# Testing
/.nyc_output
/coverage

# Build
/build
/dist
/.opt-in

# Generated translation files
/translations
/locale

# Other generated source
/src/generated

# Downloaded during "npm install": the upstream scratch-microbit hex. The
# Calliope blocks runtimes + version metadata are committed deliverables (see
# firmware/BUILD-PROVENANCE.md) — shipped WITH the editor, not rebuilt at
# deploy — so track them explicitly: the v3 (codal) blocks.hex, the mini 1/2
# (DAL) blocks-dal.hex, the universal merge, and blocks-version.json.
/static/microbit/*
!/static/microbit/blocks.hex
!/static/microbit/blocks-dal.hex
!/static/microbit/blocks-universal.hex
!/static/microbit/blocks-version.json

# HTTPS certification
*.pem

# PWA
assetsManifest.json
