<!DOCTYPE html>
<html>
  <head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="google" value="notranslate">
    <link rel="shortcut icon" href="static/favicon.ico">
    <title><%= htmlWebpackPlugin.options.title %></title>
  </head>
  <body>
    <script>
      (function () {
        const SCRATCH_LINK_PROXY_REQUEST = 'blocks.scratchLinkProxy.request';
        const params = new URLSearchParams(window.location.search);
        const truthy = ['1', 'true', 'yes'];
        const flag = value => truthy.includes(String(value || '').toLowerCase());
        const isEmbedded =
          window.self !== window.top ||
          flag(params.get('embedded')) ||
          flag(params.get('iframeBridge')) ||
          flag(params.get('controller'));

        const installScratchLinkProxy = function () {
          const parentOrigin = String(params.get('parentOrigin') || '').trim() || '*';
          const instanceId = String(params.get('instance') || '').trim() || null;
          const Scratch = self.Scratch || (self.Scratch = {});

          if (Scratch.ScratchLinkSafariSocket) {
            return;
          }

          const sockets = window.__calliopeScratchLinkProxySockets || new Map();
          window.__calliopeScratchLinkProxySockets = sockets;

          const postProxyMessage = function (message) {
            // eslint-disable-next-line no-console
            console.info('%c[bridge-iframe]%c → parent', 'color: #f97316; font-weight: bold;', 'color: inherit;', message);
            if (window.parent === window) {
              return;
            }

            window.parent.postMessage(
              {
                source: 'calliope-scratch-gui',
                version: 2,
                instanceId,
                type: SCRATCH_LINK_PROXY_REQUEST,
                data: message,
                meta: {
                  via: 'calliope-scratch-gui-bootstrap'
                }
              },
              parentOrigin
            );
          };

          class CalliopeScratchLinkProxySocket {
            static isSafariHelperCompatible() {
              return true;
            }

            constructor(type) {
              this._type = type;
              this._id = `calliope-scratchlink-${Math.random().toString(36).slice(2, 11)}`;
              this._isOpen = false;
              this._onOpen = null;
              this._onClose = null;
              this._onError = null;
              this._handleMessage = null;
            }

            open() {
              sockets.set(this._id, this);
              postProxyMessage({
                socketId: this._id,
                action: 'open',
                type: this._type
              });
            }

            close() {
              if (!sockets.has(this._id)) {
                return;
              }

              postProxyMessage({
                socketId: this._id,
                action: 'close'
              });
              this._isOpen = false;
              sockets.delete(this._id);
            }

            sendMessage(message) {
              postProxyMessage({
                socketId: this._id,
                action: 'send',
                message
              });
            }

            setOnOpen(fn) {
              this._onOpen = fn;
            }

            setOnClose(fn) {
              this._onClose = fn;
            }

            setOnError(fn) {
              this._onError = fn;
            }

            setHandleMessage(fn) {
              this._handleMessage = fn;
            }

            isOpen() {
              return this._isOpen;
            }
          }

          Scratch.ScratchLinkSafariSocket = CalliopeScratchLinkProxySocket;
          // eslint-disable-next-line no-console
          console.info(
            '%c[bridge-iframe]%c proxy installed (Scratch.ScratchLinkSafariSocket replaced)',
            'color: #f97316; font-weight: bold;', 'color: inherit;'
          );
        };

        // eslint-disable-next-line no-console
        console.info(
          '%c[bridge-iframe]%c bootstrap: embedded=' + isEmbedded +
            ', parent=' + (window.parent === window ? 'self' : 'host') +
            ', params=' + window.location.search,
          'color: #f97316; font-weight: bold;', 'color: inherit;'
        );

        if (isEmbedded) {
          // Force scratch-vm to use its `BLE` (ScratchLink) class instead
          // of `WebBLE`. The published scratch-vm we ship doesn't check
          // `__calliopeForceScratchLink` yet; it picks WebBLE whenever
          // `navigator.bluetooth` is truthy, which is always in Chrome.
          // WebBLE would do its OWN navigator.bluetooth.requestDevice and
          // bypass our parent-side proxy, so we hide the API from the
          // iframe. The parent (host app) keeps full access — only this
          // iframe is muted.
          var suppressMethod = 'none';
          try {
            Object.defineProperty(navigator, 'bluetooth', {
              value: undefined,
              configurable: true,
              writable: true
            });
            suppressMethod = 'defineProperty';
          } catch (e) {
            try {
              delete navigator.bluetooth;
              suppressMethod = 'delete';
            } catch (e2) {}
          }
          // If defineProperty silently failed (some Chrome builds expose
          // navigator.bluetooth as a non-configurable getter on the
          // prototype), redefine on Navigator.prototype as a fallback.
          if (navigator.bluetooth) {
            try {
              Object.defineProperty(Navigator.prototype, 'bluetooth', {
                value: undefined,
                configurable: true
              });
              suppressMethod = 'proto-defineProperty';
            } catch (e3) {}
          }
          // eslint-disable-next-line no-console
          console.info(
            '%c[bridge-iframe]%c navigator.bluetooth suppression: ' + suppressMethod +
              ' → ' + (navigator.bluetooth === undefined ? 'OK (undefined)' : 'FAILED (' + typeof navigator.bluetooth + ')'),
            'color: #f97316; font-weight: bold;', 'color: inherit;'
          );
          window.__calliopeForceScratchLink = true;
          installScratchLinkProxy();
          // Ping the parent so its bridge log shows we're alive even
          // before the user touches anything. The parent treats this
          // as informational; ignores in production.
          try {
            const parentOrigin = String(params.get('parentOrigin') || '').trim() || '*';
            window.parent.postMessage(
              {
                source: 'calliope-scratch-gui',
                version: 2,
                instanceId: String(params.get('instance') || '').trim() || null,
                type: 'blocks.bridge.hello',
                data: {
                  navigatorBluetoothSuppressed: !navigator.bluetooth,
                  navigatorBluetoothType: typeof navigator.bluetooth,
                  suppressMethod: suppressMethod,
                  forceScratchLink: !!window.__calliopeForceScratchLink,
                  hasScratchLinkSafariSocket: !!(self.Scratch && self.Scratch.ScratchLinkSafariSocket),
                  href: window.location.href
                },
                meta: { via: 'calliope-scratch-gui-bootstrap' }
              },
              parentOrigin
            );
          } catch (e) {
            // eslint-disable-next-line no-console
            console.warn('[bridge-iframe] hello postMessage failed', e);
          }
          return;
        }

        if ('serviceWorker' in navigator) {
          window.addEventListener('load', function () {
            navigator.serviceWorker.register('./service-worker.js').then(function (registration) {
              console.log('PWA worker registration successful', registration.scope);
            }, function (err) {
              console.log('PWA worker registration failed', err);
            }).catch(function (err) {
              console.log(err);
            });
          });
        } else {
          console.log('Service Worker is not supported by browser.');
        }
      }());
    </script>
  </body>
</html>
