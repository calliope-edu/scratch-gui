<!DOCTYPE html>
<html>
  <head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="google" value="notranslate">
    <link rel="shortcut icon" href="static/favicon.ico">
    <title><%= htmlWebpackPlugin.options.title %></title>
  </head>
  <body>
    <script>
      // Skip PWA service-worker registration when this page is loaded
      // inside another window (controller / embedded mode). Service
      // workers caching the standalone shell would otherwise interfere
      // with the host's hot-reload of the iframe.
      (function () {
        if (window.parent !== window) {
          return;
        }
        if ('serviceWorker' in navigator) {
          window.addEventListener('load', function () {
            navigator.serviceWorker.register('./service-worker.js').then(function (registration) {
              console.log('PWA worker registration successful', registration.scope);
            }, function (err) {
              console.log('PWA worker registration failed', err);
            }).catch(function (err) {
              console.log(err);
            });
          });
        }
      }());
    </script>
  </body>
</html>
